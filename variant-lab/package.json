{
  "name": "d4j-variant-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch --watch-path=server --watch-preserve-output server/index.mjs",
    "dev:api": "node server/index.mjs",
    "dev:full": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:server": "node --test server/__tests__/*.test.mjs",
    "batch:init": "node server/batchCli.mjs init",
    "batch:status": "node server/batchCli.mjs status",
    "batch:resume": "node server/batchCli.mjs resume",
    "batch:resume-originals": "node server/batchCli.mjs resume-originals",
    "batch:export": "node server/batchCli.mjs export",
    "batch:depth:init": "node server/batchCli.mjs init --batch=seven-family-l10-l90-v1",
    "batch:depth:resume-originals": "node server/batchCli.mjs resume-originals --batch=seven-family-l10-l90-v1",
    "batch:depth:resume": "node server/batchCli.mjs resume --batch=seven-family-l10-l90-v1",
    "batch:depth:status": "node server/batchCli.mjs status --batch=seven-family-l10-l90-v1",
    "accuracy:export": "node server/accuracyCli.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
