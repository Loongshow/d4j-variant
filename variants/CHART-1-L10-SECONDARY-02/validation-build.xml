<?xml version="1.0" encoding="UTF-8"?>
<project name="Chart variant validation" default="test">
    <property name="project.dir" location="."/>
    <property name="validation.dir" location="${project.dir}/build-validation"/>
    <property name="test.class"
              value="org.jfree.chart.renderer.category.junit.AbstractCategoryItemRendererTests"/>
    <property name="test.method" value="testLegendItemsForSecondaryDataset"/>

    <path id="production.classpath">
        <fileset dir="${project.dir}/lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="test.classpath">
        <pathelement location="${validation.dir}/classes"/>
        <pathelement location="${validation.dir}/test-classes"/>
        <path refid="production.classpath"/>
    </path>

    <target name="compile">
        <mkdir dir="${validation.dir}/classes"/>
        <javac srcdir="${project.dir}/source"
               destdir="${validation.dir}/classes"
               source="1.6"
               target="1.6"
               debug="true"
               includeantruntime="false"
               encoding="UTF-8">
            <classpath refid="production.classpath"/>
            <include name="org/jfree/**"/>
            <exclude name="org/jfree/chart/xml/**"/>
        </javac>
        <copy todir="${validation.dir}/classes">
            <fileset dir="${project.dir}/source">
                <include name="**/*.properties"/>
                <include name="**/*.jpg"/>
                <include name="**/*.gif"/>
                <include name="**/*.png"/>
            </fileset>
        </copy>
    </target>

    <target name="compile-tests" depends="compile">
        <mkdir dir="${validation.dir}/test-classes"/>
        <javac srcdir="${project.dir}/tests"
               destdir="${validation.dir}/test-classes"
               source="1.6"
               target="1.6"
               debug="true"
               includeantruntime="false"
               encoding="UTF-8">
            <classpath refid="test.classpath"/>
            <include name="**/*Tests.java"/>
        </javac>
    </target>

    <target name="test-class" depends="compile-tests">
        <mkdir dir="${validation.dir}/test-reports"/>
        <junit printsummary="yes"
               haltonerror="true"
               haltonfailure="true"
               fork="true">
            <formatter type="plain" usefile="false"/>
            <classpath refid="test.classpath"/>
            <test name="${test.class}"/>
        </junit>
    </target>

    <target name="test-method" depends="compile-tests">
        <mkdir dir="${validation.dir}/test-reports"/>
        <junit printsummary="yes"
               haltonerror="true"
               haltonfailure="true"
               fork="true">
            <formatter type="plain" usefile="false"/>
            <classpath refid="test.classpath"/>
            <test name="${test.class}" methods="${test.method}"/>
        </junit>
    </target>

    <target name="test" depends="compile-tests">
        <mkdir dir="${validation.dir}/test-reports"/>
        <junit printsummary="yes"
               haltonerror="true"
               haltonfailure="true"
               fork="true">
            <formatter type="plain" usefile="false"/>
            <classpath refid="test.classpath"/>
            <batchtest todir="${validation.dir}/test-reports">
                <fileset dir="${project.dir}/tests">
                    <include name="**/*Tests.java"/>
                </fileset>
            </batchtest>
        </junit>
    </target>
</project>
