diff --git a/src/test/java/org/apache/commons/compress/archivers/tar/TarArchiveEntryTest.java b/src/test/java/org/apache/commons/compress/archivers/tar/TarArchiveEntryTest.java
index bfbbe0cd..fed9564f 100644
--- a/src/test/java/org/apache/commons/compress/archivers/tar/TarArchiveEntryTest.java
+++ b/src/test/java/org/apache/commons/compress/archivers/tar/TarArchiveEntryTest.java
@@ -95,4 +95,20 @@ public class TarArchiveEntryTest extends TestCase {
             }
         }
     }
+
+    /**
+     * JIRA issue COMPRESS-194
+     *
+     * @see "https://issues.apache.org/jira/browse/COMPRESS-194"
+     */
+    public void testCompress194() {
+        final byte[] asciiHeader = new byte[] { 'u', 's', 't', 'a', 'r', ' ', ' ', 0 };
+        assertEquals(623L, TarUtils.computeCheckSum(asciiHeader));
+
+        final byte[] utf8Header = new byte[] { (byte) 0xC3, (byte) 0xA9, 'a', 0 };
+        assertEquals(461L, TarUtils.computeCheckSum(utf8Header));
+
+        final byte[] mixedHeader = new byte[] { 't', 'a', 'r', (byte) 0x80, (byte) 0xFF, (byte) 0x7F, '/', 0 };
+        assertEquals(884L, TarUtils.computeCheckSum(mixedHeader));
+    }
 }
