+    public static String[] withExplicitEnumNames(Enum<?>[] values, String[] names)
+    {
+        Map<String,String> explicit = BasicDeserializerFactory.explicitEnumNameMap(values);
+        for (int i = 0, end = values.length; i < end; ++i) {
