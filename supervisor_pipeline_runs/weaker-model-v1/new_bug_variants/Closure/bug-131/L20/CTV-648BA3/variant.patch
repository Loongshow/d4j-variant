     /**
+     * The characters a name may be written with.  {@link #START_CHAR} marks a
+     * character that may stand first in a name and {@link #PART_CHAR} one that
+     * may stand after the first; a character carrying neither bit may not
+     * appear in a name at all.  Classifying a character by table is a single
+     * array read, which is worth the space here because a compilation asks the
+     * question once per character of every name it reads.
+     */
+    private static final byte[] NAME_CHARS = new byte[Character.MAX_VALUE + 1];
+
+    static final byte START_CHAR = 1;
+    static final byte PART_CHAR = 2;
+
+    static {
+        markIdentifierChars();
+        markCurrencyChars();
+        markConnectorChars();
+    }
+
+    /**
+     * Marks the characters admitted by the Unicode identifier syntax.
+     */
+    private static void markIdentifierChars() {
+        for (int c = 0; c <= Character.MAX_VALUE; c++) {
+            char ch = (char) c;
+            if (Character.isUnicodeIdentifierStart(ch)) {
+                NAME_CHARS[c] = START_CHAR | PART_CHAR;
+            } else if (Character.isUnicodeIdentifierPart(ch)) {
+                NAME_CHARS[c] = PART_CHAR;
+            }
+        }
+    }
+
+    /**
+     * Marks the currency symbols, which the Unicode identifier syntax leaves
+     * out although "$" is written in names everywhere.
+     */
+    private static void markCurrencyChars() {
+        for (int c = 0; c <= Character.MAX_VALUE; c++) {
+            if (Character.getType((char) c) == Character.CURRENCY_SYMBOL) {
+                NAME_CHARS[c] = START_CHAR | PART_CHAR;
+            }
+        }
+    }
+
+    /**
+     * Marks the connecting punctuation as able to stand first; the Unicode
+     * identifier syntax admits "_" only after the first character.
+     */
+    private static void markConnectorChars() {
+        for (int c = 0; c <= Character.MAX_VALUE; c++) {
+            if (Character.getType((char) c) == Character.CONNECTOR_PUNCTUATION) {
+                NAME_CHARS[c] = START_CHAR | PART_CHAR;
+            }
+        }
+    }
+
+    /** Whether {@code c} may stand first in a name. */
+    public static boolean isNameStartChar(char c) {
+        return (NAME_CHARS[c] & START_CHAR) != 0;
+    }
+
+    /** Whether {@code c} may stand after the first character of a name. */
+    public static boolean isNamePartChar(char c) {
+        return (NAME_CHARS[c] & PART_CHAR) != 0;
+    }
+
