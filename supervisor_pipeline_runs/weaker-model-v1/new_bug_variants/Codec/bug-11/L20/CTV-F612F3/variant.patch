+            } else {
+                breakAfter = false;
+            }
+            if (breakAfter && blank) {
+                final char[] digits = Hex.encodeHex(new byte[] {text[j]}, false);
+                lines.write('=');
+                lines.write(digits[0]);
+                lines.write(digits[1]);
+                column += 3;
+            } else {
+                lines.write(text, j, width);
+                column += width;
+            }
+            if (breakAfter) {
+                lines.write('=');
+                lines.write('\r');
+                lines.write('\n');
+                column = 1;
+            }
+            j += width;
+        }
