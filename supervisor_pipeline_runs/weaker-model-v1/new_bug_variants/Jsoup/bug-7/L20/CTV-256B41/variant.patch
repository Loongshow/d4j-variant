diff --git a/src/main/java/org/jsoup/select/Elements.java b/src/main/java/org/jsoup/select/Elements.java
index 782d71aa..990092c9 100644
--- a/src/main/java/org/jsoup/select/Elements.java
+++ b/src/main/java/org/jsoup/select/Elements.java
@@ -419,6 +419,23 @@ public class Elements implements List<Element> {
 
     public boolean remove(Object o) {return contents.remove(o);}
 
+    /**
+     * Finds the first element with the given tag name.
+     * @param root the element to search
+     * @param tagName lower-case tag name
+     * @return the first element with the tag name, or null if none is found
+     */
+    public static Element firstTagged(Element root, String tagName) {
+        Elements candidates = root.children();
+        for (int i = 0; i < candidates.size(); i++) {
+            Element candidate = candidates.get(i);
+            if (candidate.tagName().equals(tagName))
+                return candidate;
+        }
+        return null;
+    }
+
