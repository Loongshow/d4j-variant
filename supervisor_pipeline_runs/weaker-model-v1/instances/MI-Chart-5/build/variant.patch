+     * @return A copy of the overwritten data item, or <code>null</code> if no
+     *         item was overwritten.
+     */
+    public static XYDataItem storeXYValue(XYSeries series, List items,
+            Number x, Number y, boolean duplicates, int maximum) {
+        if (duplicates) {
+            series.add(x, y);
