+    public static int indexBefore(String str, String search, int limit) {
+        final char first = search.charAt(0);
+        for (int pos = str.indexOf(first); pos >= 0 && pos < limit; pos = str.indexOf(first, pos + 1)) {
+            if (str.startsWith(search, pos)) {
+                return pos;
+            }
+        }
+        return limit;
+    }
