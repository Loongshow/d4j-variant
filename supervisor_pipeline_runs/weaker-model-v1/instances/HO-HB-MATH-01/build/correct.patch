+    /** Compute the fraction locating the point of a chord closest to a given point.
+     * <p>The chord joins {@code a} (fraction 0) to {@code b} (fraction 1). The orthogonal
+     * projection of {@code p} on the line through {@code a} and {@code b} has the fraction
+     * r = ((p - a) &middot; (b - a)) / |b - a|<sup>2</sup>. The value returned is r reduced
+     * to the range [0, 1]: r itself when 0 &le; r &le; 1, 0 when r &lt; 0 and 1 when
+     * r &gt; 1. For distinct {@code a} and {@code b} the returned fraction therefore always
+     * lies within [0, 1] (it is NaN when they coincide).</p>
+     * @param a first end of the chord
+     * @param b second end of the chord
+     * @param p point to locate
+     * @return fraction, within [0, 1], of the point of the chord closest to {@code p}
+     */
+    public static double chordFraction(final Vector2D a, final Vector2D b, final Vector2D p) {
+        final double deltaX = b.x - a.x;
+        final double deltaY = b.y - a.y;
+        final double along  = ((p.x - a.x) * deltaX + (p.y - a.y) * deltaY) /
+                              (deltaX * deltaX + deltaY * deltaY);
+        return FastMath.max(0.0, FastMath.min(1.0, along));
+    }
+
