+     * unchanged.</p>
+     * @param a first end of the chord (fraction 0)
+     * @param b second end of the chord (fraction 1)
+     * @param fraction fraction along the chord
+     * @return point at the given fraction along the chord
+     */
+    public static Vector2D chordPoint(final Vector2D a, final Vector2D b, final double fraction) {
+        return new Vector2D(Interval.positionAt(a.x, b.x, fraction),
+                            Interval.positionAt(a.y, b.y, fraction));
+    }
