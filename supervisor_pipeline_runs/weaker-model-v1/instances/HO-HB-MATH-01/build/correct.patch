+    /** Get the value located at a given fraction of the way from one bound to another.
+     * <p>The value is {@code from + fraction * (to - from)}: fraction 0 gives {@code from}
+     * and fraction 1 gives {@code to}. The fraction must already lie within [0, 1] for the
+     * value to lie between the two bounds; it is applied as given, without clamping, so a
+     * fraction outside [0, 1] gives a value outside them.</p>
+     * @param from value at fraction 0
+     * @param to value at fraction 1
+     * @param fraction fraction of the way from {@code from} to {@code to}
+     * @return value at the given fraction
+     */
+    public static double positionAt(final double from, final double to, final double fraction) {
+        return from + fraction * (to - from);
+    }
