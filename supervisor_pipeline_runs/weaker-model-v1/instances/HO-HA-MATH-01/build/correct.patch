+    /**
+     * Returns the cost of carrying the running surplus of histogram {@code a}
+     * over histogram {@code b} along a row of bins spaced one unit apart.
+     * <p>
+     * The listed bins are visited in increasing order with a surplus that starts
+     * at 0. At bin {@code j} the surplus becomes {@code (a[j] + surplus) - b[j]},
+     * and it is then carried from {@code j} to the next listed bin, or to index
+     * {@code a.length} after the last listed bin. Carrying it costs its absolute
+     * value for every unit step travelled, that is
+     * {@code |surplus| * (next - j)}. The method returns the sum of these costs.
+     * </p>
+     * <p>
+     * Bins missing from {@code bins} are expected to be empty in both
+     * histograms: the surplus passes through them unchanged, so each of them adds
+     * one more unit step to the trip that crosses it.
+     * </p>
+     *
+     * @param a masses of the first histogram, one entry per bin
+     * @param b masses of the second histogram, at least as long as {@code a}
+     * @param bins indices of the bins that hold mass, in increasing order
+     * @return the total carrying cost
+     */
+    public static double carriedCost(final double[] a, final double[] b, final int[] bins) {
+        double surplus = 0;
+        double cost = 0;
+        for (int k = 0; k < bins.length; k++) {
+            final int j = bins[k];
+            final int next = k + 1 < bins.length ? bins[k + 1] : a.length;
+            surplus = (a[j] + surplus) - b[j];
+            cost += FastMath.abs(surplus) * (next - j);
+        }
+        return cost;
+    }
+
