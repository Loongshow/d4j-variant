@@ -533,6 +533,32 @@ public class Frequency implements Serializable {
 
     //----------------------------------------------------------------------------------------------
 
+    /**
+     * Returns the indices of the bins that hold mass in at least one of two
+     * histograms over the same bins.
+     * <p>
+     * Index {@code i} is listed exactly when {@code a[i] != 0} or
+     * {@code b[i] != 0}, for {@code 0 <= i < a.length}. The indices are returned
+     * in increasing order; bins that are empty in both histograms are left out.
+     * </p>
+     *
+     * @param a masses of the first histogram, one entry per bin
+     * @param b masses of the second histogram, at least as long as {@code a}
+     * @return the indices of the occupied bins, in increasing order
+     */
+    public static int[] occupiedBins(final double[] a, final double[] b) {
+        final int[] bins = new int[a.length];
+        int count = 0;
+        for (int i = 0; i < a.length; i++) {
+            if (a[i] != 0 || b[i] != 0) {
+                bins[count++] = i;
+            }
+        }
+        final int[] occupied = new int[count];
+        System.arraycopy(bins, 0, occupied, 0, count);
+        return occupied;
+    }
