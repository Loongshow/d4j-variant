+     * @return the function's name, or {@code null} if it has no name
+     */
+    public static String functionOrKeyName(Node fnNode, Node parent) {
+      String name = JSTypeRegistry.declaredFunctionName(fnNode, parent);
+      if (name != null) {
+        return name;
