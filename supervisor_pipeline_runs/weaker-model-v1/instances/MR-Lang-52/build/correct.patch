+    public static void appendEscapedChars(StringBuffer buffer, char[] array) {
+        for (int i = 0; i < array.length; i++) {
+            char c = array[i];
+            String entityName = Entities.HTML40.entityName(c);
+            if (entityName == null && c > 0x7F) {
