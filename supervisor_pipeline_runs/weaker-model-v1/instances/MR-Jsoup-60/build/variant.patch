+     */
+    public static void appendUnescaped(StringBuilder accum, String text) {
+        int start = 0;
+        for (int esc = text.indexOf('\\'); esc != -1; esc = text.indexOf('\\', esc + 1)) {
+            accum.append(text, start, esc);
+            start = esc + 1;
+        }
+        accum.append(text, start, text.length());
+    }
