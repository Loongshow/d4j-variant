+     * @param threshold the threshold length of the segment growth
+     * @return the expanded length of the segment
+     */
+    public static int expandedBufferLength(final int length, final int threshold) {
+        int grown = length + (length >> 1);
+        if (grown > threshold) {
+            grown = threshold;
+        }
