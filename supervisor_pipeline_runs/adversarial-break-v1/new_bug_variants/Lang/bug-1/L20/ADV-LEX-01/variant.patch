+     * @param width the width of a value
+     * @param field the field covering one value
+     * @return the widened values combined into the result
+     */
+    public static long widen(final int[] run, final long initial, final int at, final int width, final long field) {
+        if (wordOffset(run.length - 1, at, width) < 0) {
+            throw new IllegalArgumentException("run does not fit the holder");
+        }
+        final long[] words = new long[run.length];
+        for (int i = 0; i < run.length; i++) {
+            words[i] = run[i] & field;
+        }
+        return ObjectUtils.combine(words, initial, at, width, field);
+    }
