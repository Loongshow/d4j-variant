diff --git a/tests/org/jfree/chart/plot/junit/PiePlotTests.java b/tests/org/jfree/chart/plot/junit/PiePlotTests.java
index fae7cc6..250263c 100644
--- a/tests/org/jfree/chart/plot/junit/PiePlotTests.java
+++ b/tests/org/jfree/chart/plot/junit/PiePlotTests.java
@@ -670,4 +670,32 @@ public class PiePlotTests extends TestCase {
         assertTrue(success);
     }
 
+    /**
+     * Some checks for the bounds of exploded pie sections.
+     */
+    public void test2986548() {
+        ArcProbe plot = new ArcProbe();
+        Rectangle2D unexploded = new Rectangle2D.Double(100.0, 100.0, 200.0,
+                200.0);
+        Rectangle2D exploded = new Rectangle2D.Double(50.0, 50.0, 300.0, 300.0);
+        Rectangle2D bounds = plot.arc(unexploded, exploded, 135.0, 90.0, 0.25);
+        assertTrue(bounds.getX() == 87.5 && bounds.getY() == 100.0
+                && bounds.getWidth() == 200.0 && bounds.getHeight() == 200.0);
+        bounds = plot.arc(unexploded, exploded, 0.0, 90.0, 0.5);
+        assertTrue(Math.abs(bounds.getX() - 117.67766952966369) < 0.0000001
+                && Math.abs(bounds.getY() - 82.32233047033631) < 0.0000001);
+        assertSame(unexploded, plot.arc(unexploded, exploded, 0.0, 90.0, 0.0));
+    }
+
+    /**
+     * A plot that exposes the bounds of its sections.
+     */
+    static class ArcProbe extends PiePlot {
+        Rectangle2D arc(Rectangle2D unexploded, Rectangle2D exploded,
+                double angle, double extent, double explodePercent) {
+            return getArcBounds(unexploded, exploded, angle, extent,
+                    explodePercent);
+        }
+    }
+
 }
