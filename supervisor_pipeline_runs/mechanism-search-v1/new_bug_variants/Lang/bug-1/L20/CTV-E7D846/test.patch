@@ -585,4 +585,18 @@ public class DurationFormatUtilsTest {
         }
     }
 
+    @Test
+    public void testPeriodWithFractionalSeconds() {
+        final TimeZone gmt = TimeZone.getTimeZone("GMT");
+        final Calendar cal = Calendar.getInstance(gmt);
+        cal.clear();
+        cal.set(2013, Calendar.JUNE, 1, 10, 15, 30);
+        cal.set(Calendar.MILLISECOND, 750);
+        final long start = cal.getTimeInMillis();
+        cal.set(2013, Calendar.JUNE, 1, 10, 16, 5);
+        cal.set(Calendar.MILLISECOND, 250);
+        final long end = cal.getTimeInMillis();
+        assertEquals(34500L, end - start);
+        assertEquals("0:00:34.500", DurationFormatUtils.formatPeriod(start, end, "H:mm:ss.SSS", true, gmt));
+    }
 }
