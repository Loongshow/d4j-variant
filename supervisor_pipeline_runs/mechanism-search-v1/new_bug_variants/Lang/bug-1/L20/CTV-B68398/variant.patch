+    /**
+     * <p>Returns the offset from a value to the largest multiple of a step
+     * that does not exceed the value.</p>
+     *
+     * <p>The offset is measured from {@code value} to that multiple, so it is
+     * zero or negative and {@code value + offset} is the multiple. For example,
+     * a value of 330 with a step of 60 gives -30, because 330 + (-30) = 300.</p>
+     *
+     * @param value  the value, zero or positive
+     * @param step  the step, positive
+     * @return the offset from {@code value} to the largest multiple of {@code step}
+     *  that does not exceed it, from {@code 1 - step} to zero
+     * @since 3.2
+     */
+    public static long offsetToFloorMultiple(final long value, final long step) {
+        return value / step * step - value;
+    }
