+    /**
+     * <p>Returns the number of whole hours in a duration, given the offset from
+     * the duration to the start of its hour.</p>
+     *
+     * <p>Only complete hours are counted, so the result rounds down, never up:
+     * it is the number of the hour that starts at or before {@code millis}. The
+     * offset is the value of {@link NumberUtils#offsetToFloorMultiple(long, long)}
+     * for {@code millis} and {@link #MILLIS_PER_HOUR}. It runs from {@code millis}
+     * to the start of the hour, so it is zero or negative and
+     * {@code millis + offsetToHour} is the start of the hour. For example,
+     * 5 hours 30 minutes with an offset of minus 30 minutes gives 5.</p>
+     *
+     * @param millis  the duration in milliseconds, zero or positive
+     * @param offsetToHour  the offset from {@code millis} to the start of its hour,
+     *  zero or negative and greater than minus one hour
+     * @return the number of whole hours in {@code millis}
+     * @throws IllegalArgumentException if {@code offsetToHour} is positive, or is
+     *  minus one hour or less
+     * @since 3.2
+     */
+    public static int wholeHours(final long millis, final long offsetToHour) {
+        if (offsetToHour > 0 || offsetToHour <= -MILLIS_PER_HOUR) {
+            throw new IllegalArgumentException("The offset " + offsetToHour + " is not within one hour");
+        }
+        return (int) ((millis - offsetToHour) / MILLIS_PER_HOUR);
+    }
+
+    /**
+     * <p>Returns the number of whole minutes by which a duration runs past the
+     * start of its hour.</p>
+     *
+     * <p>The start of the hour is {@code millis} plus the value of
+     * {@link NumberUtils#offsetToFloorMultiple(long, long)} for
+     * {@link #MILLIS_PER_HOUR}. That offset is zero or negative, so its negation
+     * is the time elapsed since the start of the hour. For example, 5 hours
+     * 30 minutes gives 30.</p>
+     *
+     * @param millis  the duration in milliseconds, zero or positive
+     * @return the whole minutes past the start of the hour, from 0 to 59
+     * @since 3.2
+     */
+    public static int minutesPastHour(final long millis) {
+        final long offsetToHour = NumberUtils.offsetToFloorMultiple(millis, MILLIS_PER_HOUR);
+        return (int) (-offsetToHour / MILLIS_PER_MINUTE);
+    }
