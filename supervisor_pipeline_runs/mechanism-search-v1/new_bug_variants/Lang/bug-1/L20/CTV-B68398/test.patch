+    @Test
+    public void testIsoDateTimeForKolkata() {
+        final TimeZone kolkata = TimeZone.getTimeZone("Asia/Kolkata");
+        final Calendar cal = Calendar.getInstance(kolkata);
+        cal.clear();
+        cal.set(2013, Calendar.MARCH, 4, 9, 15, 0);
+        assertEquals("2013-03-04T09:15:00+05:30",
+                DateFormatUtils.format(cal.getTime(), "yyyy-MM-dd'T'HH:mm:ssZZ", kolkata));
+    }
 }
