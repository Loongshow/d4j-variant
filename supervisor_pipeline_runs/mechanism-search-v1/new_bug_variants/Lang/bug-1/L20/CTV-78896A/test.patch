+    @Test
+    public void testLang1149() {
+        // Characters whose upper-case forms agree while their lower-case forms differ (or
+        // the other way round) compare equal ignoring case, whatever the CharSequence
+        // implementation: the CharSequence comparison must agree with the String one.
+        final String longS = "\u017F"; // LATIN SMALL LETTER LONG S, upper-cases to S
+        final String kelvin = "\u212A"; // KELVIN SIGN, lower-cases to k
+        assertTrue(StringUtils.equalsIgnoreCase(longS, "s"));
+        assertTrue(StringUtils.equalsIgnoreCase(kelvin, "K"));
+        assertEquals(StringUtils.equalsIgnoreCase(longS, "s"),
+                     StringUtils.equalsIgnoreCase(new StringBuilder(longS), "s"));
+        assertEquals(StringUtils.equalsIgnoreCase(kelvin, "K"),
+                     StringUtils.equalsIgnoreCase(new StringBuilder(kelvin), "K"));
+        assertEquals(StringUtils.equalsIgnoreCase("ab" + longS, "ABS"),
+                     StringUtils.equalsIgnoreCase(new StringBuilder("ab" + longS), "ABS"));
+    }
 }
