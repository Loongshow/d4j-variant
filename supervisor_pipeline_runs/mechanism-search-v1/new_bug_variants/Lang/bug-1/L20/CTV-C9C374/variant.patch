+     * @param at  the position in the holder at which the first value of the run is placed
+     * @param width  the width of a value
+     * @param field  the field covering one value
+     * @return the holder with the value placed
+     */
+    public static long overlay(final long holder, final long word, final int index, final int at, final int width, final long field) {
+        final int shift = index * width + at;
+        return (holder & ~(field << shift)) | (word << shift);
+    }
