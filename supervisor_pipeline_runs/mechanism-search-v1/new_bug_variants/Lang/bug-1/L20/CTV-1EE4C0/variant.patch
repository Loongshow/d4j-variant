+package org.apache.commons.lang3;
+
+/**
+ * <p>Packs {@code short} values, 16 bits each.</p>
+ *
+ * @since 3.2
+ */
+final class Packer16 implements Packer {
+
+    public long pack(final Object source, final int sourcePos, final long holder, final int holderPos, final int count) {
+        final short[] src = (short[]) source;
+        long out = holder;
+        int shift = 0;
