+    public void testTarUnarchiveEntryAttributes() throws Exception {
+        final InputStream is = new FileInputStream(getFile("bla.tar"));
+        final ArchiveInputStream in = new ArchiveStreamFactory().createArchiveInputStream("tar", is);
+        final TarArchiveEntry entry = (TarArchiveEntry) in.getNextEntry();
+        assertEquals("test1.xml", entry.getName());
+        assertEquals(0644, entry.getMode());
+        assertEquals(610, entry.getSize());
+        assertEquals(1195035542000L, entry.getModTime().getTime());
+        in.close();
+    }
+
+    public void testTarHeaderChecksumAndTypeFlag() {
+        final TarArchiveEntry entry = new TarArchiveEntry("lib", TarConstants.LF_DIR);
+        entry.setModTime(0);
+        final byte[] header = new byte[512];
+        entry.writeEntryHeader(header);
+
+        final int checksumOffset = TarConstants.NAMELEN + TarConstants.MODELEN + TarConstants.UIDLEN
+            + TarConstants.GIDLEN + TarConstants.SIZELEN + TarConstants.MODTIMELEN;
+        long sum = 0;
+        for (int i = 0; i < header.length; i++) {
+            final boolean inChecksum = i >= checksumOffset && i < checksumOffset + TarConstants.CHKSUMLEN;
+            sum += inChecksum ? ' ' : (header[i] & 0xff);
+        }
+        assertEquals(sum, TarUtils.parseOctal(header, checksumOffset, TarConstants.CHKSUMLEN));
+        assertEquals(TarConstants.LF_DIR, header[checksumOffset + TarConstants.CHKSUMLEN]);
+        assertTrue(new TarArchiveEntry(header).isDirectory());
+    }
 }
