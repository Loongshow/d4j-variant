+    public static double survey(final double[] values, final double floor, final double ceiling) {
+        double major = 0;
+        double top = 0;
+        double middle = 0;
+        double minor = 0;
+        double bottom = 0;
+        for (int i = 0; i < values.length; i++) {
+            final double x = Math.abs(values[i]);
+            if (x > ceiling) {
+                if (x > top) {
+                    final double r = top / x;
+                    major = 1 + major * r * r;
+                    top = x;
+                } else {
+                    final double r = x / top;
+                    major += r * r;
+                }
+            } else if (x < floor) {
