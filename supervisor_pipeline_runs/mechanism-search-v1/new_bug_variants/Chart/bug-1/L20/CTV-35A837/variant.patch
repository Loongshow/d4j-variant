diff --git a/source/org/jfree/chart/util/ShapeUtilities.java b/source/org/jfree/chart/util/ShapeUtilities.java
index 5c137f7..37fe1ef 100644
--- a/source/org/jfree/chart/util/ShapeUtilities.java
+++ b/source/org/jfree/chart/util/ShapeUtilities.java
@@ -705,4 +705,19 @@ public class ShapeUtilities {
 
     }
 
+    /**
+     * Rebuilds an area at the given anchor, preserving its size.
+     *
+     * @param area  the area.
+     * @param x  the x-coordinate of the new anchor.
+     * @param y  the y-coordinate of the new anchor.
+     *
+     * @return The rebuilt area.
+     */
+    public static Rectangle2D shift(Rectangle2D area, double x, double y) {
+        double w = area.getWidth();
+        double h = area.getHeight();
+        return new Rectangle2D.Double(x, y, w, h);
+    }
+
 }
