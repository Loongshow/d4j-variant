diff --git a/source/org/jfree/chart/plot/PlotUtilities.java b/source/org/jfree/chart/plot/PlotUtilities.java
index 74a0df4..14002a1 100644
--- a/source/org/jfree/chart/plot/PlotUtilities.java
+++ b/source/org/jfree/chart/plot/PlotUtilities.java
@@ -41,6 +41,9 @@
 
 package org.jfree.chart.plot;
 
+import java.awt.geom.Point2D;
+import java.awt.geom.Rectangle2D;
+
 import org.jfree.data.general.DatasetUtilities;
 import org.jfree.data.xy.XYDataset;
 
@@ -73,4 +76,19 @@ public class PlotUtilities {
         return true;
     }
 
+    /**
+     * Computes the offset between the mid-angle point of a section on the
+     * unexploded ring and the corresponding point on the exploded ring.
+     *
+     * @param point1  the point on the unexploded ring.
+     * @param point2  the corresponding point on the exploded ring.
+     *
+     * @return The offset.
+     */
+    public static Point2D offset(Point2D point1, Point2D point2) {
+        double dx = point2.getX() - point1.getX();
+        double dy = point2.getY() - point1.getY();
+        return new Point2D.Double(dx, dy);
+    }
+
 }
