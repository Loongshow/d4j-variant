+    public void testUtf8ForAstralCharacter() throws Exception
+    {
+        JsonStringEncoder encoder = new JsonStringEncoder();
+        byte[] utf8 = encoder.encodeAsUTF8("\uD83D\uDE00");
+        StringBuilder hex = new StringBuilder();
+        for (byte b : utf8) {
+            hex.append(Integer.toHexString(0x100 | (b & 0xFF)).substring(1));
+        }
+        assertEquals("f09f9880", hex.toString());
+    }
