+    public void testSurrogateUnitPositions()
+    {
+        assertEquals(0, CharTypes.surrogateOffset(0xD800, 0xD800));
+        assertEquals(-0x3D, CharTypes.surrogateOffset(0xD83D, 0xD800));
+        assertEquals(-0x3FF, CharTypes.surrogateOffset(0xDFFF, 0xDC00));
+        assertEquals(0, CharTypes.lowSurrogateIndex(0xDC00));
+        assertEquals(0x200, CharTypes.lowSurrogateIndex(0xDE00));
+        assertEquals(0x3FF, CharTypes.lowSurrogateIndex(0xDFFF));
+    }
