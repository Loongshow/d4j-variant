+    /**
+     * Archives the same slice of a larger buffer twice, once deflated and
+     * once stored, and reads both entries back with ZipFile.
+     * @throws Exception
+     */
+    public void testZipArchiveCreationFromBufferSlice() throws Exception {
+        final byte[] data = "##Hello, sliced archive data!##".getBytes("US-ASCII");
+        final int off = 2;
+        final int len = data.length - 4;
+        final CRC32 sliceCrc = new CRC32();
+        sliceCrc.update(data, off, len);
+
+        final File output = new File(dir, "slice.zip");
+        final ZipArchiveOutputStream zos = new ZipArchiveOutputStream(new FileOutputStream(output));
+        zos.putArchiveEntry(new ZipArchiveEntry("deflated.txt"));
+        zos.write(data, off, len);
+        final ZipArchiveEntry stored = new ZipArchiveEntry("stored.txt");
+        stored.setMethod(ZipArchiveEntry.STORED);
+        stored.setSize(len);
+        stored.setCrc(sliceCrc.getValue());
+        zos.putArchiveEntry(stored);
+        zos.write(data, off, len);
+        zos.close();
+
+        final ZipFile zf = new ZipFile(output);
+        try {
+            final String[] names = new String[] {"deflated.txt", "stored.txt"};
+            for (int i = 0; i < names.length; i++) {
+                final ZipArchiveEntry entry = zf.getEntry(names[i]);
+                assertNotNull(names[i], entry);
+                assertEquals(names[i], sliceCrc.getValue(), entry.getCrc());
+                assertEquals(names[i], len, entry.getSize());
+                final InputStream in = zf.getInputStream(entry);
+                final ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                IOUtils.copy(in, bos);
+                in.close();
+                assertEquals(names[i], new String(data, off, len, "US-ASCII"), bos.toString("US-ASCII"));
+            }
+        } finally {
+            ZipFile.closeQuietly(zf);
+        }
+    }
 }
