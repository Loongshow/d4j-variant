+    public void testTokenColumnsAcrossLines() throws Exception
+    {
+        JsonParser jp = createParserUsingReader("[ [\n  true ] ]");
+        assertToken(JsonToken.START_ARRAY, jp.nextToken());
+        JsonLocation outer = jp.getTokenLocation();
+        assertToken(JsonToken.START_ARRAY, jp.nextToken());
+        JsonLocation inner = jp.getTokenLocation();
+        assertToken(JsonToken.VALUE_TRUE, jp.nextToken());
+        JsonLocation value = jp.getTokenLocation();
+        assertToken(JsonToken.END_ARRAY, jp.nextToken());
+        assertToken(JsonToken.END_ARRAY, jp.nextToken());
+        assertNull(jp.nextToken());
+        jp.close();
+
+        assertEquals(1, outer.getLineNr());
+        assertEquals(1, outer.getColumnNr());
+        assertEquals(1, inner.getLineNr());
+        assertEquals(3, inner.getColumnNr());
+        assertEquals(2, value.getLineNr());
+        assertEquals(3, value.getColumnNr());
+    }
+}
