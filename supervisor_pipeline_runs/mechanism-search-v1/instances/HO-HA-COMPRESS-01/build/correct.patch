+    /**
+     * Writes the octal digits of a value right-aligned into the field
+     * <code>buf[offset, offset + width)</code> and fills the leading
+     * bytes the digits do not use with spaces. Zero is written as the
+     * single digit <code>'0'</code>, a negative value as spaces only,
+     * and a value with more digits than the field holds as its
+     * low-order digits. Exactly the <code>width</code> bytes of the
+     * field are written; no byte outside the field is touched.
+     *
+     * @param value the value to write
+     * @param buf the buffer holding the field
+     * @param offset the offset of the field in the buffer
+     * @param width the length of the field, at least 1
+     */
+    public static void putOctalDigits(long value, byte[] buf, int offset, int width) {
+        int idx = width - 1;
+        if (value == 0) {
+            buf[offset + idx] = (byte) '0';
+            --idx;
+        } else {
+            for (long val = value; idx >= 0 && val > 0; --idx) {
+                buf[offset + idx] = (byte) ((byte) '0' + (byte) (val & 7));
+                val = val >> 3;
+            }
+        }
+        for (; idx >= 0; --idx) {
+            buf[offset + idx] = (byte) ' ';
+        }
+    }
+
+    /**
+     * Writes the terminator of a tar header checksum field into the
+     * last two bytes of the field <code>field[start, start + width)</code>:
+     * a NUL byte at index <code>start + width - 2</code>, followed by a
+     * space at index <code>start + width - 1</code>. The bytes before
+     * the terminator are left unchanged.
+     *
+     * @param field the buffer holding the field
+     * @param start the offset of the field in the buffer
+     * @param width the length of the field, at least 2
+     */
+    public static void terminateChecksum(byte[] field, int start, int width) {
+        field[start + width - 2] = 0;
+        field[start + width - 1] = (byte) ' ';
+    }
 }
