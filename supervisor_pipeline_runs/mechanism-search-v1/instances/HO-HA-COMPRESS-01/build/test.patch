+
+    public void testHeaderChecksumFieldLayout() {
+        // the checksum field follows name, mode, uid, gid, size and mtime
+        final int start = TarConstants.NAMELEN + TarConstants.MODELEN
+            + TarConstants.UIDLEN + TarConstants.GIDLEN
+            + TarConstants.SIZELEN + TarConstants.MODTIMELEN;
+        byte[] header = new byte[512];
+        Arrays.fill(header, start, start + TarConstants.CHKSUMLEN, (byte) ' ');
+        int next = TarUtils.getCheckSumOctalBytes(012345, header, start,
+                                                  TarConstants.CHKSUMLEN);
+        assertEquals(start + TarConstants.CHKSUMLEN, next);
+        byte[] field = new byte[TarConstants.CHKSUMLEN];
+        System.arraycopy(header, start, field, 0, field.length);
+        assertEquals("[32, 49, 50, 51, 52, 53, 0, 32]", Arrays.toString(field));
+    }
+
+    public void testOctalDigitsFillTheirWidth() {
+        byte[] buf = new byte[] {9, 9, 9, 9, 9, 9, 9, 9};
+        IOUtils.putOctalDigits(012345, buf, 1, 6);
+        assertEquals("[9, 32, 49, 50, 51, 52, 53, 9]", Arrays.toString(buf));
+        IOUtils.putOctalDigits(0, buf, 1, 6);
+        assertEquals("[9, 32, 32, 32, 32, 32, 48, 9]", Arrays.toString(buf));
+    }
