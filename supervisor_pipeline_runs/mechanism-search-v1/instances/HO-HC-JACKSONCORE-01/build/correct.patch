index 75912e52..34e93dcb 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonEncoding.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonEncoding.java
@@ -49,4 +49,24 @@ public enum JsonEncoding {
      *   (or if not applicable)
      */
     public boolean isBigEndian() { return _bigEndian; }
+
+    /**
+     * Returns the supplementary code point (U+10000 to U+10FFFF) of a UTF-16
+     * surrogate pair, given its two parts as computed by
+     * {@link com.fasterxml.jackson.core.io.CharTypes}:
+     *<ul>
+     * <li>{@code highOffset}: the offset from the high surrogate to U+D800, the start
+     *   of the high-surrogate block; this is zero or negative (see
+     *   {@link com.fasterxml.jackson.core.io.CharTypes#surrogateOffset})</li>
+     * <li>{@code lowIndex}: the index of the low surrogate within the low-surrogate
+     *   block, 0 to 0x3FF</li>
+     *</ul>
+     * The result grows with the position of the high surrogate: the pair
+     * (U+D800, U+DC00) gives U+10000, and every code unit by which the high surrogate
+     * lies above U+D800 adds 0x400 to the result. {@code lowIndex} is added as given.
+     */
+    public static int supplementaryCodePoint(int highOffset, int lowIndex)
+    {
+        return 0x10000 - highOffset * 0x400 + lowIndex;
+    }
 }
