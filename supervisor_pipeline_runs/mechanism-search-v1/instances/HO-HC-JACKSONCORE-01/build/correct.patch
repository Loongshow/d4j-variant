+        assertEquals(0, CharTypes.surrogateOffset(0xD800, 0xD800));
+        assertEquals(-0x3D, CharTypes.surrogateOffset(0xD83D, 0xD800));
+        assertEquals(-0x3FF, CharTypes.surrogateOffset(0xDFFF, 0xDC00));
