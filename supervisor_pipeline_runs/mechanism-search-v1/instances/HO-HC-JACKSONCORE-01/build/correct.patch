+++ b/src/main/java/com/fasterxml/jackson/core/io/CharTypes.java
@@ -2,6 +2,8 @@ package com.fasterxml.jackson.core.io;
 
 import java.util.Arrays;
 
+import com.fasterxml.jackson.core.JsonEncoding;
+
 public final class CharTypes
 {
     private final static char[] HEX_CHARS = "0123456789ABCDEF".toCharArray();
@@ -230,5 +232,54 @@ public final class CharTypes
     {
         return (byte[]) HEX_BYTES.clone();
     }
+
+    /**
+     * Returns the offset from the UTF-16 code unit {@code unit} to {@code blockStart},
+     * the first code unit of the surrogate block that {@code unit} belongs to: the
+     * amount that has to be added to {@code unit} to reach {@code blockStart}, that is
+     * {@code blockStart - unit}. For a unit inside the block the result is zero or
+     * negative: 0 for the first unit of the block, down to -0x3FF for the last one.
+     *
+     * @param unit UTF-16 code unit (a high or a low surrogate)
+     * @param blockStart First code unit of the block: 0xD800 for high surrogates,
+     *   0xDC00 for low surrogates
+     */
+    public static int surrogateOffset(int unit, int blockStart)
+    {
+        return blockStart - unit;
+    }
+
+    /**
+     * Returns the index of the low surrogate {@code low} within the low-surrogate
+     * block U+DC00 to U+DFFF: 0 for U+DC00, increasing by one per code unit up to
+     * 0x3FF for U+DFFF. This index forms the ten low-order bits of the supplementary
+     * code point of the surrogate pair. Since {@link #surrogateOffset} returns the
+     * offset from a unit to the start of its block, the index is that offset negated.
+     */
+    public static int lowSurrogateIndex(int low)
+    {
+        return -surrogateOffset(low, 0xDC00);
+    }
+
+    /**
+     * Returns the supplementary code point (U+10000 to U+10FFFF) encoded by the
+     * UTF-16 surrogate pair {@code high}, {@code low}. The pair is checked first:
+     * {@code high} has to lie in the high-surrogate block U+D800 to U+DBFF and
+     * {@code low} in the low-surrogate block U+DC00 to U+DFFF; otherwise an
+     * {@link IllegalArgumentException} is thrown. The code point is then assembled by
+     * {@link JsonEncoding#supplementaryCodePoint} from the offset of {@code high} to
+     * U+D800, as returned by {@link #surrogateOffset}, and the index of {@code low},
+     * as returned by {@link #lowSurrogateIndex}.
+     */
+    public static int combineSurrogates(int high, int low)
+    {
+        int highOffset = surrogateOffset(high, 0xD800);
+        int lowIndex = lowSurrogateIndex(low);
+        if (highOffset > 0 || highOffset < -0x3FF || lowIndex < 0 || lowIndex > 0x3FF) {
+            throw new IllegalArgumentException("Invalid surrogate pair: first char 0x"
+                    +Integer.toHexString(high)+", second 0x"+Integer.toHexString(low));
+        }
+        return JsonEncoding.supplementaryCodePoint(highOffset, lowIndex);
+    }
 }
 
