+    public void testBinaryFormatRoundTrip() throws Exception {
+        final byte[] content = "binary cpio".getBytes("US-ASCII");
+
+        final ByteArrayOutputStream bout = new ByteArrayOutputStream();
+        final CpioArchiveOutputStream os =
+            new CpioArchiveOutputStream(bout, CpioConstants.FORMAT_OLD_BINARY);
+        final CpioArchiveEntry entry = new CpioArchiveEntry(CpioConstants.FORMAT_OLD_BINARY);
+        entry.setName("data.txt");
+        entry.setMode(CpioConstants.C_ISREG | 0644);
+        entry.setNumberOfLinks(1);
+        entry.setTime(1000);
+        entry.setSize(content.length);
+        os.putArchiveEntry(entry);
+        os.write(content, 0, content.length);
+        os.closeArchiveEntry();
+        os.close();
+
+        final byte[] archive = bout.toByteArray();
+        assertEquals(86, archive.length);
+
+        final CpioArchiveInputStream in =
+            new CpioArchiveInputStream(new ByteArrayInputStream(archive));
+        final CpioArchiveEntry back = in.getNextCPIOEntry();
+        assertEquals("data.txt", back.getName());
+        assertEquals(content.length, back.getSize());
+        final ByteArrayOutputStream data = new ByteArrayOutputStream();
+        IOUtils.copy(in, data);
+        final byte[] restored = data.toByteArray();
+        assertEquals(content.length, restored.length);
+        for (int i = 0; i < content.length; i++) {
+            assertEquals("byte " + i, content[i], restored[i]);
+        }
+        assertNull(in.getNextCPIOEntry());
+        in.close();
+    }
 }
