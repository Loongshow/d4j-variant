+    public void testEntryTimestampRoundTrip() throws Exception {
+        final File archive = new File(dir, "stamped.zip");
+        final Calendar cal = Calendar.getInstance();
+        cal.clear();
+        cal.set(2008, Calendar.JUNE, 15, 10, 20, 46);
+
+        final ZipArchiveOutputStream zos = new ZipArchiveOutputStream(archive);
+        final ZipArchiveEntry stamped = new ZipArchiveEntry("stamped.txt");
+        stamped.setTime(cal.getTime().getTime());
+        zos.putArchiveEntry(stamped);
+        zos.write("stamped".getBytes());
+        zos.closeArchiveEntry();
+        zos.close();
+
+        final ZipFile zf = new ZipFile(archive);
+        try {
+            final SimpleDateFormat fmt = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
+            final long readBack = zf.getEntry("stamped.txt").getTime();
+            assertEquals("2008-06-15 10:20:46", fmt.format(new Date(readBack)));
+        } finally {
+            zf.close();
+            archive.delete();
+        }
