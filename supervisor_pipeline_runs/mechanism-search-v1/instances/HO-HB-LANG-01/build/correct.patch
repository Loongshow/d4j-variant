+     * @param colon  whether to put a {@code ':'} between the hour and minute fields
+     */
+    public static void appendZoneOffset(final StringBuffer buffer, final int offsetMillis, final boolean colon) {
+        int hours = offsetMillis / (60 * 60 * 1000);
