+    //-----------------------------------------------------------------------
+    /**
+     * <p>Gets the minute field of a time zone offset, as written in the
+     * {@code +HHMM} form.</p>
+     *
+     * <p>The minute field is taken from the magnitude of the offset: it is the
+     * number of whole minutes left over once the whole hours have been removed.
+     * The result is always in the range 0 to 59, whatever the sign of the offset.
+     * For example, both {@code +09:45} and {@code -09:45} give 45, and
+     * {@code -07:00} gives 0.</p>
+     *
+     * @param offsetMillis  the offset from UTC in milliseconds, may be negative
+     * @return the minute field of the offset, from 0 to 59
+     */
+    public static int offsetMinuteField(final int offsetMillis) {
+        final int totalMinutes = Math.abs(offsetMillis) / (60 * 1000);
+        return totalMinutes % 60;
+    }
     
