+    @Test
+    public void testHalfHourZonesEitherSideOfUtc() {
+        final long instant = 1000000000000L;
+        final String east = DateFormatUtils.format(instant, "ZZ", TimeZone.getTimeZone("GMT+05:30"), Locale.US);
+        final String west = DateFormatUtils.format(instant, "ZZ", TimeZone.getTimeZone("GMT-03:30"), Locale.US);
+        assertEquals("+05:30 -03:30", east + " " + west);
+    }
