+
+    //--------------------------------------------------------------------------
+    /**
+     * <p>Appends a value to a buffer as exactly two decimal digits, tens first.</p>
+     *
+     * <p>The value must already be in the range 0 to 99; it is placed as given,
+     * one digit character per decimal place, with no range check.</p>
+     *
+     * <pre>
+     *   CharUtils.appendTwoDigits(buffer, 7)  appends "07"
+     *   CharUtils.appendTwoDigits(buffer, 42) appends "42"
+     * </pre>
+     *
+     * @param buffer  the buffer to append to, not null
+     * @param value  the value to append, from 0 to 99
+     */
+    public static void appendTwoDigits(final StringBuffer buffer, final int value) {
+        buffer.append((char) (value / 10 + '0'));
+        buffer.append((char) (value % 10 + '0'));
+    }
     
 }
