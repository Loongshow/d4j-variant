@@ -535,5 +535,25 @@ public class CharUtils {
     public static boolean isAsciiAlphanumeric(final char ch) {
         return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9');
