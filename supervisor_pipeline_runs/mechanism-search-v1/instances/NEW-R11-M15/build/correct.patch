+    @Test
+    public void testTwoStateChainExactAndFloatingStepsAgree() {
+        final FieldMatrix<BigFraction> exact = MatrixUtils.createFieldMatrix(new BigFraction[][] {
+            { new BigFraction(3, 4), new BigFraction(1, 4) },
+            { new BigFraction(1, 4), new BigFraction(3, 4) }
+        });
+        final RealMatrix approximate = MatrixUtils.createRealMatrix(new double[][] {
+            { 0.75, 0.25 },
+            { 0.25, 0.75 }
+        });
+        for (final int n : new int[] { 1, 2, 10, 100, 1000, 2000 }) {
+            final FieldMatrix<BigFraction> exactSteps = exact.power(n);
+            final RealMatrix approximateSteps = approximate.power(n);
+            for (int i = 0; i < 2; i++) {
+                for (int j = 0; j < 2; j++) {
+                    Assert.assertEquals(approximateSteps.getEntry(i, j),
+                                        exactSteps.getEntry(i, j).doubleValue(), 1.0e-12);
+                }
+            }
+        }
+    }
