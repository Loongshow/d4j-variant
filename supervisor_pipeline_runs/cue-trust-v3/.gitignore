# Kept on disk only (bulk, regenerable, or sensitive), following adversarial-break-v1's layout.
# Defects4J checkouts made during construction and mutation screening
construction/fresh/
construction/work/
construction/agent*/fresh/
construction/agent*/work/
construction/agentB/screen[0-9]*/
construction/agentB/probe/
*.class
# Server copies (regenerated by scripts/setup_server.py), their run trees and symlinks
models/*/variant-lab/
models/*/benchmark_runs/
models/*/runs/
models/*/workspaces
models/*/new_bug_variants
# Raw provider responses: traceback locals in them hold key-shaped strings. Facts are in diagnostic/HALT_EVIDENCE.json.
diagnostic/diag_run_response.json
diagnostic/probe_*.json
# Per-run agent workspaces and empty result folders
workspace_archive/
results/
# Process files
*.pid
*.out
.DS_Store
