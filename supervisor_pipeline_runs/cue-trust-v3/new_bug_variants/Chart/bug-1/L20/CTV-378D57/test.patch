+    /**
+     * Checks the auto-range of both axes when an image annotation is
+     * included in the data bounds.
+     */
+    public void testAutoRangeWithImageAnnotationBounds() {
+        XYSeries series = new XYSeries("S1");
+        series.add(1.0, 2.0);
+        series.add(2.0, 3.0);
+        XYSeriesCollection dataset = new XYSeriesCollection(series);
+        NumberAxis xAxis = new NumberAxis("X");
+        NumberAxis yAxis = new NumberAxis("Y");
+        xAxis.setAutoRangeIncludesZero(false);
+        yAxis.setAutoRangeIncludesZero(false);
+        xAxis.setLowerMargin(0.0);
+        xAxis.setUpperMargin(0.0);
+        yAxis.setLowerMargin(0.0);
+        yAxis.setUpperMargin(0.0);
+        XYPlot plot = new XYPlot(dataset, xAxis, yAxis,
+                new XYLineAndShapeRenderer());
+        Image image = new BufferedImage(4, 4, BufferedImage.TYPE_INT_ARGB);
+        plot.addAnnotation(new XYDataImageAnnotation(image, 5.0, 20.0, 3.0,
+                4.0, true));
+        xAxis.configure();
+        yAxis.configure();
+        assertEquals(8.0, xAxis.getUpperBound(), 0.0000001);
+        assertEquals(24.0, yAxis.getUpperBound(), 0.0000001);
+    }
