  "code": "    /**\n     * Checks the auto-range of both axes when an image annotation is\n     * included in the data bounds.\n     */\n    public void testAutoRangeWithImageAnnotationBounds() {\n        XYSeries series = new XYSeries(\"S1\");\n        series.add(1.0, 2.0);\n        series.add(2.0, 3.0);\n        XYSeriesCollection dataset = new XYSeriesCollection(series);\n        NumberAxis xAxis = new NumberAxis(\"X\");\n        NumberAxis yAxis = new NumberAxis(\"Y\");\n        xAxis.setAutoRangeIncludesZero(false);\n        yAxis.setAutoRangeIncludesZero(false);\n        xAxis.setLowerMargin(0.0);\n        xAxis.setUpperMargin(0.0);\n        yAxis.setLowerMargin(0.0);\n        yAxis.setUpperMargin(0.0);\n        XYPlot plot = new XYPlot(dataset, xAxis, yAxis,\n                new XYLineAndShapeRenderer());\n        Image image = new BufferedImage(4, 4, BufferedImage.TYPE_INT_ARGB);\n        plot.addAnnotation(new XYDataImageAnnotation(image, 5.0, 20.0, 3.0,\n                4.0, true));\n        xAxis.configure();\n        yAxis.configure();\n        assertEquals(8.0, xAxis.getUpperBound(), 0.0000001);\n        assertEquals(24.0, yAxis.getUpperBound(), 0.0000001);\n    }\n"
 },
